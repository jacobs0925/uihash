{
  "primer-react": {
    "url": "https://github.com/primer/react",
    "branch": "main",
    "lockfile": "package-lock.json",
    "install": "npm ci --no-audit --no-fund --loglevel=error",
    "storybookPackage": "packages/react",
    "storybookConfig": "packages/react/.storybook/main.ts",
    "storiesPattern": "DEPLOY_ENV === 'development'\n      ? ['../src/**/*.mdx', '../src/**/*.stories.@(js|jsx|ts|tsx)']\n      : // Don't include dev stories in production\n        ['../src/**/*.mdx', '../src/**/!(*.dev).stories.@(js|jsx|ts|tsx)']",
    "storyGlob": "../src/{c}/**/*.stories.@(js|jsx|ts|tsx)",
    "patches": [
      [
        "prc-[folder]-[local]-[hash:base64:5]",
        "prc-[folder]-[local]"
      ]
    ],
    "build": "npx storybook build --quiet --disable-telemetry -o {out}",
    "componentRoot": "packages/react/src",
    "skipDirs": [
      "internal",
      "utils",
      "hooks",
      "__tests__",
      "stories",
      "experimental",
      "drafts",
      "deprecated",
      "legacy-theme",
      "theme",
      "constants",
      "utils-tests",
      "docs"
    ],
    "style": "\\.(css|scss)$|\\.module\\.css$",
    "snapshots": "(-snapshots/|__snapshots__/|/snapshots/).*\\.png$"
  },
  "eui": {
    "url": "https://github.com/elastic/eui",
    "branch": "main",
    "lockfile": "yarn.lock",
    "install": "corepack yarn install --immutable && corepack yarn workspace @elastic/eui-theme-common build && corepack yarn workspace @elastic/eui-theme-borealis build",
    "storybookPackage": "packages/eui",
    "storybookConfig": "packages/eui/.storybook/main.ts",
    "storiesPattern": [
      "['../src/**/*.stories.@(js|jsx|ts|tsx)']",
      "['../src/**/*.mdx', '../src/**/*.stories.@(js|jsx|ts|tsx)']"
    ],
    "storyGlob": "../src/components/{c}/**/*.stories.@(js|jsx|ts|tsx)",
    "patches": [],
    "build": "npx storybook build --quiet --disable-telemetry -o {out}",
    "componentRoot": "packages/eui/src/components",
    "skipDirs": [
      "common",
      "index.ts",
      "__snapshots__"
    ],
    "style": "\\.styles\\.ts$|\\.scss$",
    "snapshots": "\\.vrt/reference/.*\\.png$",
    "node": "nvmrc",
    "version": 2
  },
  "primer-brand": {
    "url": "https://github.com/primer/brand",
    "branch": "main",
    "lockfile": "package-lock.json",
    "install": "npm ci --no-audit --no-fund --loglevel=error",
    "storybookPackage": "apps/storybook",
    "storybookConfig": "apps/storybook/.storybook/main.js",
    "storiesPattern": "['../../../packages/react/src/**/*.stories.@(js|jsx|ts|tsx)']",
    "storyGlob": "../../../packages/react/src/{c}/**/*.stories.@(js|jsx|ts|tsx)",
    "patches": [],
    "build": "(cd ../../packages/design-tokens && npm run build --silent) && NODE_ENV=test npx storybook build --quiet --disable-telemetry -o {out}",
    "componentRoot": "packages/react/src",
    "skipDirs": [
      "css",
      "fixtures",
      "hooks",
      "utils",
      "test-utils",
      "component-helpers"
    ],
    "style": "\\.css$",
    "snapshots": "\\.visual\\.spec\\.tsx?-snapshots/.*\\.png$",
    "node": "24.14.1"
  },
  "siemens-ix": {
    "url": "https://github.com/siemens/ix",
    "branch": "main",
    "lockfile": "pnpm-lock.yaml",
    "install": "corepack pnpm install --frozen-lockfile --filter storybook-docs...",
    "storybookPackage": "packages/storybook-docs",
    "storybookConfig": "packages/storybook-docs/.storybook/main.ts",
    "storiesPattern": "['../src/**/*.mdx', '../src/**/*.stories.@(js|jsx|mjs|ts|tsx)']",
    "storyGlob": "../src/stories/**/{c}{.stories,/**/*.stories}.@(js|jsx|mjs|ts|tsx)",
    "patches": [],
    "build": "cd ../core && printf \"import { config as c } from './stencil.config';\\nexport const config = { ...c, outputTargets: c.outputTargets.filter((t) => ['dist', 'dist-custom-elements', 'docs-custom'].includes(t.type)) };\\n\" > stencil.walk.config.ts && npx stencil build --prod --config stencil.walk.config.ts && cd ../storybook-docs && npx storybook build --quiet --disable-telemetry -o {out}",
    "componentRoot": "packages/core/src/components",
    "skipDirs": [
      "utils",
      "ix-playground"
    ],
    "style": "\\.s?css$",
    "snapshots": "(__screenshots__|-snapshots)/.*\\.png$"
  },
  "vkui": {
    "url": "https://github.com/vkcom/VKUI",
    "branch": "master",
    "lockfile": "yarn.lock",
    "install": "YARN_ENABLE_SCRIPTS=false YARN_ENABLE_HARDENED_MODE=0 corepack yarn install --immutable",
    "storybookPackage": "packages/vkui",
    "storybookConfig": "packages/vkui/.storybook/main.ts",
    "storiesPattern": "['../docs/**/*.mdx', '../src/**/*.mdx', '../src/**/*.stories.@(js|jsx|ts|tsx)']",
    "storyGlob": "../src/components/{c}/**/*.stories.@(js|jsx|ts|tsx)",
    "patches": [
      [
        "return mergeConfig(config, {\n      define: {",
        "return mergeConfig(config, {\n      css: { modules: { generateScopedName: 'vkui[folder]__[local]' } },\n      define: {"
      ]
    ],
    "build": "npx storybook build --quiet --disable-telemetry -o {out}",
    "skipStories": "^devtools-",
    "componentRoot": "packages/vkui/src/components",
    "skipDirs": [],
    "style": "\\.css$",
    "snapshots": "__image_snapshots__/.*\\.(png|webp)$"
  },
  "gravity-uikit": {
    "url": "https://github.com/gravity-ui/uikit",
    "branch": "main",
    "lockfile": "package-lock.json",
    "install": "HUSKY=0 npm ci --no-audit --no-fund --loglevel=error --before=\"$(git log -1 --format=%cI)\"",
    "storybookPackage": ".",
    "storybookConfig": ".storybook/main.ts",
    "storiesPattern": "['../src/**/*.mdx', '../src/**/*.stories.@(ts|tsx)']",
    "storyGlob": "../src/components/{c}/**/*.stories.@(ts|tsx)",
    "patches": [],
    "build": "npx storybook build --quiet --disable-telemetry -o {out}",
    "componentRoot": "src/components",
    "skipDirs": [
      "utils",
      "mobile",
      "theme",
      "ControlLabel"
    ],
    "style": "\\.(css|scss)$",
    "snapshots": "__snapshots__/[^/]+-snapshots/[^/]+\\.png$"
  },
  "fuselage": {
    "url": "https://github.com/RocketChat/fuselage",
    "branch": "main",
    "lockfile": "yarn.lock",
    "install": "corepack yarn install --immutable --mode=skip-build",
    "storybookPackage": "packages/fuselage",
    "storybookConfig": "packages/fuselage/.storybook/main.ts",
    "storiesPattern": "['../src/**/*.stories.{mdx,js,tsx}', '../src/**/*.mdx']",
    "storyGlob": "../src/components/{c}/**/*.stories.{js,tsx}",
    "patches": [
      [
        "reactDocgen: 'react-docgen-typescript'",
        "reactDocgen: false"
      ]
    ],
    "build": "(cd ../.. && TURBO_TELEMETRY_DISABLED=1 corepack yarn turbo run build --filter=@rocket.chat/fuselage^... --no-daemon --output-logs=errors-only) && npx storybook build --quiet --disable-telemetry -o {out}",
    "componentRoot": "packages/fuselage/src/components",
    "skipDirs": [],
    "style": "\\.scss$",
    "snapshots": "packages/fuselage/test/snapshots/.*\\.png$"
  },
  "spectrum-web-components-2nd-gen": {
    "url": "https://github.com/adobe/spectrum-web-components",
    "branch": "main",
    "lockfile": "yarn.lock",
    "install": "corepack yarn install --immutable",
    "storybookPackage": "2nd-gen/packages/swc",
    "storybookConfig": "2nd-gen/packages/swc/.storybook/main.ts",
    "storiesPattern": "export default config;",
    "storyGlob": "../components/{c}/**/*.stories.ts",
    "patches": [
      [
        "[\"../components/",
        "export default { ...config, stories: [\"../components/"
      ],
      [
        ".stories.ts\"]",
        ".stories.ts\"] };"
      ],
      [
        "resolve(__dirname, './addons/screen-reader-addon')",
        "...[]",
        "optional"
      ]
    ],
    "build": "corepack yarn analyze && npx storybook build --quiet --disable-telemetry -o {out}",
    "componentRoot": "2nd-gen/packages/swc/components",
    "skipDirs": [],
    "style": "\\.css$",
    "snapshots": "^$",
    "node": "nvmrc",
    "changesets": "^(2nd-gen/)?\\.changeset/(?!README\\.md$)[^/]+\\.md$"
  },
  "spectrum-web-components": {
    "url": "https://github.com/adobe/spectrum-web-components",
    "branch": "main",
    "lockfile": "yarn.lock",
    "install": "corepack yarn install --immutable",
    "storybookPackage": "gen2/packages/swc",
    "storybookConfig": "gen2/packages/swc/.storybook/main.ts",
    "storiesPattern": "export default config;",
    "storyGlob": "../components/{c}/**/*.stories.ts",
    "patches": [
      [
        "[\"../components/",
        "export default { ...config, stories: [\"../components/"
      ],
      [
        ".stories.ts\"]",
        ".stories.ts\"] };"
      ],
      [
        "resolve(__dirname, './addons/screen-reader-addon')",
        "...[]",
        "optional"
      ]
    ],
    "build": "corepack yarn analyze && npx storybook build --quiet --disable-telemetry -o {out}",
    "componentRoot": "gen2/packages/swc/components",
    "skipDirs": [],
    "style": "\\.css$",
    "snapshots": "^$",
    "node": "nvmrc",
    "changesets": "^(gen2/)?\\.changeset/(?!README\\.md$)[^/]+\\.md$"
  }
}
