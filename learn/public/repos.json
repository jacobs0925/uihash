  "fluentui": {
    "url": "https://github.com/microsoft/fluentui",
    "branch": "master",
    "lockfile": "yarn.lock",
    "install": "if [ -f .yarnrc.yml ]; then corepack yarn install --immutable --mode=skip-build; else corepack yarn install --frozen-lockfile --ignore-scripts --network-timeout 600000; fi",
    "storybookPackage": ".",
    "storybookConfig": ".storybook/main.js",
    "storiesPattern": "[]",
    "storyGlob": "../packages/react-components/{c}/stories/src/**/index.stories.@(ts|tsx)",
